      "file": "docker-compose.yml",
      "services": {
        "mariadb": {
          "health_timeout": 300,
          "backup": {"type": "mariadb-dump", "dir": "/home/pi/photoprism/backups-mariadb", "keep": 4},
          "health": [
            {"exec": ["sh", "-c", "MYSQL_PWD=\"$MARIADB_ROOT_PASSWORD\" exec mariadb -uroot -e 'SELECT 1'"]},
