{
  "textfile_dir": "/var/lib/node_exporter/textfile_collector",
  "projects": [
    {
      "dir": "/home/pi/monitoring",
      "file": "docker-compose.yml",
      "services": {
        "node-exporter": {
          "health": [{"http": "http://127.0.0.1:9100/metrics"}]
        },
        "blackbox": {
          "health": [{"exec": ["wget", "-qO-", "http://127.0.0.1:9115/-/healthy"]}]
        },
        "alertmanager": {
          "health": [{"exec": ["wget", "-qO-", "http://127.0.0.1:9093/-/ready"]}]
        },
        "grafana": {
          "backup": {"type": "volume-tar", "volume": "grafana-data", "dir": "/var/backups/familia-docker", "keep": 2},
          "health": [{"http": "http://127.0.0.1:9003/api/health"}]
        },
        "prometheus": {
          "health_timeout": 600,
          "health": [{"http": "http://127.0.0.1:9090/-/ready"}]
        }
      }
    }
  ]
